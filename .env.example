# ---- Pick backends ---------------------------------------------------------
# fake/hash = fully offline demo. openai / azure / ollama = real models.
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=hash

# ---- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Azure OpenAI (AI Foundry) --------------------------------------------
# Leave AZURE_OPENAI_API_KEY empty to use Managed Identity / `az login`.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---- Ollama (local open models) ------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Vector DB -------------------------------------------------------------
# :memory: | http://localhost:6333 | ./qdrant_data
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge

# ---- Behaviour -------------------------------------------------------------
TOP_K=4
MIN_SCORE=0.05
AGENT_MAX_STEPS=6
PROMPT_PINS={}
API_KEY=
LOG_LEVEL=INFO
